-- v1 -> v2: sync state for the network client, plus the outbox indexes that
-- v1 installs predate (IF NOT EXISTS keeps fresh v2 databases unaffected).
CREATE TABLE sync_status (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    pull_cursor INTEGER NOT NULL DEFAULT 0,
    last_sync_at TEXT,
    last_error TEXT
);
CREATE UNIQUE INDEX IF NOT EXISTS op_outbox_device_counter ON op_outbox(device_id, counter);
CREATE INDEX IF NOT EXISTS op_outbox_pending ON op_outbox(synced);
