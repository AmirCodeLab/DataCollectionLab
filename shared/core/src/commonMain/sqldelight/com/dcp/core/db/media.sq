-- Local media staging and upload state (encryption envelope §6, sync §9).
--
-- The design in one sentence: **a captured file is encrypted before it touches
-- the disk, and its key lives in this database.**
--
-- That is what makes "media at rest is encrypted" true without a second key
-- hierarchy. This database is SQLCipher-encrypted under a key the platform
-- keystore holds (§14), so the media key is protected by the keystore
-- transitively; and the bytes on the filesystem are AES-256-GCM ciphertext that
-- nothing outside this database can open. A photograph of an ID card is never
-- written in the clear, not even for a moment — the plaintext goes from the
-- camera buffer through the compressor into the cipher, and only ciphertext is
-- written.
--
-- It also means the staged file IS the upload. Chunks are encrypted once, at
-- capture, and uploaded byte for byte: nothing is re-encrypted on the way out,
-- so a resumed upload provably sends the same bytes as the first attempt, and
-- the content hash computed at capture is the one the server verifies.

CREATE TABLE media (
    media_id TEXT NOT NULL PRIMARY KEY,
    submission_id TEXT NOT NULL,
    -- The op whose value references this file. Known here because the client
    -- writes both; the server may learn it from the op or from us (sync §9).
    op_id TEXT,
    field_path TEXT NOT NULL,
    filename TEXT NOT NULL,
    mime_type TEXT NOT NULL,
    -- What the file was before encryption. Goes into the op's media reference
    -- as `size`, which is what a reader wants to know.
    plaintext_size INTEGER NOT NULL,
    -- What is actually on disk and on the wire: plaintext plus one 16-byte GCM
    -- tag per chunk.
    ciphertext_size INTEGER NOT NULL,
    chunk_count INTEGER NOT NULL,
    -- Over the CIPHERTEXT, never the plaintext (§6). Computed once at capture.
    ciphertext_hash TEXT NOT NULL,
    -- The per-file media key (§6). Never leaves this database in the clear;
    -- only the wrapped copies below are ever uploaded.
    media_key BLOB NOT NULL,
    content_key_id TEXT NOT NULL,
    -- 0 in `standard` mode, where the server is entitled to read the file and
    -- the chunks are decrypted on the way out. The file on THIS device is
    -- encrypted either way — at-rest protection does not depend on the
    -- project's server-side trust model.
    encrypted INTEGER NOT NULL DEFAULT 1,
    -- Where the ciphertext chunks live, as an opaque platform path.
    storage_dir TEXT NOT NULL,
    created_at TEXT NOT NULL,
    -- The server's session id, kept so a resumed upload can continue rather
    -- than reopening blindly. Cleared when the session is refused as expired.
    upload_id TEXT,
    -- 1 once the server has sealed the file (POST .../complete succeeded).
    uploaded INTEGER NOT NULL DEFAULT 0,
    -- Why the last upload attempt failed, kept so the UI can say "3 photos
    -- stuck: hash_mismatch" instead of showing a spinner forever.
    last_error TEXT
);

CREATE INDEX media_submission ON media(submission_id);

-- The upload loop's working set: staged files the server has not sealed.
CREATE INDEX media_pending ON media(uploaded);

-- Which chunks the server has acknowledged. Rows rather than a high-water
-- mark: a chunk that fails mid-upload leaves a gap, and a client that resumed
-- from the first gap would re-send everything after it. On a 2G link that is
-- the difference between an upload that finishes and one that never does.
CREATE TABLE media_chunk_state (
    media_id TEXT NOT NULL,
    chunk_index INTEGER NOT NULL,
    uploaded INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (media_id, chunk_index)
);

-- The media key wrapped once per active project key (§6, §4.3). Stored rather
-- than recomputed so a retried upload sends the same bytes, and so a wrap
-- survives the recipient set changing under us mid-upload.
CREATE TABLE media_wrap (
    media_id TEXT NOT NULL,
    project_key_id TEXT NOT NULL,
    ephemeral_public BLOB NOT NULL,
    nonce BLOB NOT NULL,
    wrapped_key BLOB NOT NULL,
    PRIMARY KEY (media_id, project_key_id)
);

-- Single-row cache of GET /api/v1/devices/{id}/media-policy. Cached for the
-- same reason as the crypto config: a device may go two weeks without a server
-- and has to keep capturing to the project's settings throughout.
CREATE TABLE media_policy (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    image_max_dimension INTEGER NOT NULL,
    image_quality INTEGER NOT NULL,
    gps_max_accuracy_m INTEGER NOT NULL,
    fetched_at TEXT NOT NULL
);

insertMedia:
INSERT INTO media(media_id, submission_id, op_id, field_path, filename, mime_type,
                  plaintext_size, ciphertext_size, chunk_count, ciphertext_hash,
                  media_key, content_key_id, encrypted, storage_dir, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getMedia:
SELECT * FROM media WHERE media_id = ?;

mediaForSubmission:
SELECT * FROM media WHERE submission_id = ? ORDER BY created_at, media_id;

-- Oldest first, so a device that captured ten photographs uploads them in the
-- order they were taken rather than in whatever order the rows come back.
pendingMedia:
SELECT * FROM media WHERE uploaded = 0 ORDER BY created_at, media_id LIMIT ?;

countPendingMedia:
SELECT COUNT(*) FROM media WHERE uploaded = 0;

setMediaOpId:
UPDATE media SET op_id = ? WHERE media_id = ?;

-- Promotes a file staged as plaintext-upload to an encrypted upload, once the
-- project's security mode is actually known. See MediaUploader.resolveEncryption.
markMediaEncrypted:
UPDATE media SET encrypted = 1, content_key_id = ? WHERE media_id = ?;

setUploadId:
UPDATE media SET upload_id = ? WHERE media_id = ?;

markMediaUploaded:
UPDATE media SET uploaded = 1, last_error = NULL WHERE media_id = ?;

recordMediaError:
UPDATE media SET last_error = ? WHERE media_id = ?;

deleteMedia:
DELETE FROM media WHERE media_id = ?;

markChunkUploaded:
INSERT OR REPLACE INTO media_chunk_state(media_id, chunk_index, uploaded)
VALUES (?, ?, 1);

uploadedChunks:
SELECT chunk_index FROM media_chunk_state
WHERE media_id = ? AND uploaded = 1 ORDER BY chunk_index;

clearChunkState:
DELETE FROM media_chunk_state WHERE media_id = ?;

insertMediaWrap:
INSERT OR REPLACE INTO media_wrap(media_id, project_key_id, ephemeral_public,
                                  nonce, wrapped_key)
VALUES (?, ?, ?, ?, ?);

wrapsForMedia:
SELECT project_key_id, ephemeral_public, nonce, wrapped_key FROM media_wrap
WHERE media_id = ? ORDER BY project_key_id;

clearMediaWraps:
DELETE FROM media_wrap WHERE media_id = ?;

getMediaPolicy:
SELECT image_max_dimension, image_quality, gps_max_accuracy_m, fetched_at
FROM media_policy WHERE id = 1;

putMediaPolicy:
INSERT OR REPLACE INTO media_policy(id, image_max_dimension, image_quality,
                                    gps_max_accuracy_m, fetched_at)
VALUES (1, ?, ?, ?, ?);
