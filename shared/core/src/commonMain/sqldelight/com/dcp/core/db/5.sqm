-- v5 -> v6: the form versions this device holds
-- (specs/sync-protocol-v0.1.md §5; retention per Form IR §9).
--
-- Migrated rather than recreated, like every step before it: a device in the
-- field carries its op log and its logical counter across upgrades, and
-- operation nonces are derived from (deviceId, counter) (envelope §4.5). A
-- device that reset its counter and later encrypted would reuse a nonce, which
-- is the one failure AES-GCM does not tolerate.
--
-- Purely additive — no existing table is touched — so a device mid-upgrade
-- keeps everything it had and gains somewhere to put the forms it is sent. It
-- arrives with the table empty and no forms until its next sync, which is
-- correct: before this version the only form it could have was the bundled one,
-- and the bundled one is not a form the server ever deployed to it.
--
-- Mirrors the matching CREATE statements in forms.sq; keep the two in step.

CREATE TABLE form_version (
    form_version_id TEXT NOT NULL PRIMARY KEY,
    form_id TEXT NOT NULL,
    version INTEGER NOT NULL,
    title TEXT NOT NULL,
    ir_json TEXT NOT NULL,
    ir_checksum TEXT NOT NULL,
    deployed INTEGER NOT NULL DEFAULT 1,
    fetched_at TEXT NOT NULL
);

CREATE UNIQUE INDEX form_version_key ON form_version(form_id, version);

CREATE INDEX form_version_deployed ON form_version(deployed);
