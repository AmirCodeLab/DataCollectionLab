-- Local submission store and operation outbox, per specs/sync-protocol-v0.1.md.
-- A submission's answers are never stored materialised: the op log IS the
-- durable state. Reopening a draft folds its ops back through the form engine.

CREATE TABLE submission (
    submission_id TEXT NOT NULL PRIMARY KEY,
    form_id TEXT NOT NULL,
    form_version INTEGER NOT NULL,
    status TEXT NOT NULL DEFAULT 'draft',
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL
);

-- Sync protocol §2. `counter` is the per-device monotonic logical counter;
-- `wall_clock` is diagnostic only and never used for ordering (§3).
CREATE TABLE op_outbox (
    op_id TEXT NOT NULL PRIMARY KEY,
    submission_id TEXT NOT NULL,
    form_id TEXT NOT NULL,
    form_version INTEGER NOT NULL,
    kind TEXT NOT NULL,
    path TEXT,
    value_json TEXT,
    device_id TEXT NOT NULL,
    actor_id TEXT NOT NULL,
    counter INTEGER NOT NULL,
    wall_clock TEXT NOT NULL,
    synced INTEGER NOT NULL DEFAULT 0,
    -- Why the server refused this op, kept until the server accepts it, so the
    -- UI can say "3 ops rejected: not_authorized" instead of pretending they
    -- synced.
    reject_reason TEXT
);

CREATE INDEX op_outbox_submission ON op_outbox(submission_id, counter);

-- (counter, deviceId) is the sync ordering key; a duplicate counter on one
-- device would silently corrupt last-writer-wins folds. Enforced here so a
-- broken counter allocation fails loudly at insert instead.
CREATE UNIQUE INDEX op_outbox_device_counter ON op_outbox(device_id, counter);

-- The push loop's working set: everything not yet accepted by the server.
CREATE INDEX op_outbox_pending ON op_outbox(synced);

-- Single-row table holding this device's identity and its logical counter.
-- The counter is never reset (§2), so it lives in the database, not in memory.
CREATE TABLE device_state (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    device_id TEXT NOT NULL,
    counter INTEGER NOT NULL,
    -- 1 once the server has acknowledged POST /api/v1/devices for device_id;
    -- pushing before that gets every op rejected not_authorized.
    registered INTEGER NOT NULL DEFAULT 0
);

-- Single-row sync state: the pull cursor (persisted only after a pulled batch
-- is durably written, sync §5), the last successful sync, and the last error.
CREATE TABLE sync_status (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    pull_cursor INTEGER NOT NULL DEFAULT 0,
    last_sync_at TEXT,
    last_error TEXT
);

getDeviceState:
SELECT device_id, counter, registered FROM device_state WHERE id = 1;

initDeviceState:
INSERT OR IGNORE INTO device_state(id, device_id, counter) VALUES (1, ?, 0);

markDeviceRegistered:
UPDATE device_state SET registered = 1 WHERE id = 1;

bumpCounter:
UPDATE device_state SET counter = counter + 1 WHERE id = 1;

insertSubmission:
INSERT INTO submission(submission_id, form_id, form_version, status, created_at, updated_at)
VALUES (?, ?, ?, 'draft', ?, ?);

touchSubmission:
UPDATE submission SET updated_at = ? WHERE submission_id = ?;

setSubmissionStatus:
UPDATE submission SET status = ?, updated_at = ? WHERE submission_id = ?;

-- pending_ops counts everything the server has NOT accepted — rejected ops
-- included, so a rejected op can never look like it synced.
getSubmission:
SELECT s.submission_id, s.form_id, s.form_version, s.status, s.created_at, s.updated_at,
       (SELECT COUNT(*) FROM op_outbox o
         WHERE o.submission_id = s.submission_id AND o.synced != 1) AS pending_ops
FROM submission s
WHERE s.submission_id = ?;

-- Newest first, with the count of ops still waiting to be pushed.
listSubmissions:
SELECT s.submission_id, s.form_id, s.form_version, s.status, s.created_at, s.updated_at,
       (SELECT COUNT(*) FROM op_outbox o
         WHERE o.submission_id = s.submission_id AND o.synced != 1) AS pending_ops
FROM submission s
ORDER BY s.updated_at DESC;

insertOp:
INSERT INTO op_outbox(op_id, submission_id, form_id, form_version, kind, path,
                      value_json, device_id, actor_id, counter, wall_clock)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Replay order for materialising a draft: (counter, deviceId), sync §3.
opsForSubmission:
SELECT * FROM op_outbox
WHERE submission_id = ?
ORDER BY counter ASC, device_id ASC;

initSyncStatus:
INSERT OR IGNORE INTO sync_status(id) VALUES (1);

getSyncStatus:
SELECT pull_cursor, last_sync_at, last_error FROM sync_status WHERE id = 1;

setPullCursor:
UPDATE sync_status SET pull_cursor = ? WHERE id = 1;

recordSyncSuccess:
UPDATE sync_status SET last_sync_at = ?, last_error = NULL WHERE id = 1;

recordSyncError:
UPDATE sync_status SET last_error = ? WHERE id = 1;

-- The push loop's batches, oldest first. synced: 0 pending, 1 acknowledged by
-- the server, 2 rejected by the server. Rejected ops stay in the outbox with
-- their reason; requeueRejectedOps returns them to 0 at the start of the next
-- sync, so they are retried then but cannot spin the push loop within one.
pendingOps:
SELECT * FROM op_outbox WHERE synced = 0 ORDER BY counter ASC LIMIT ?;

countPendingOps:
SELECT COUNT(*) FROM op_outbox WHERE synced != 1;

markOpSynced:
UPDATE op_outbox SET synced = 1, reject_reason = NULL WHERE op_id = ?;

markOpRejected:
UPDATE op_outbox SET synced = 2, reject_reason = ? WHERE op_id = ?;

requeueRejectedOps:
UPDATE op_outbox SET synced = 0 WHERE synced = 2;

-- What is still stuck and why, for the sync bar. reject_reason survives a
-- requeue, so the explanation does not flicker away while a retry is in
-- flight; acceptance clears it.
rejectedOpSummary:
SELECT reject_reason, COUNT(*) AS op_count FROM op_outbox
WHERE synced != 1 AND reject_reason IS NOT NULL
GROUP BY reject_reason
ORDER BY op_count DESC, reject_reason ASC;

-- A pulled remote op: already on the server, so synced = 1. INSERT OR IGNORE
-- makes replaying our own ops (or any prior pull) a no-op via the op_id key.
insertRemoteOp:
INSERT OR IGNORE INTO op_outbox(op_id, submission_id, form_id, form_version, kind, path,
                                value_json, device_id, actor_id, counter, wall_clock, synced)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 1);

insertSubmissionIfAbsent:
INSERT OR IGNORE INTO submission(submission_id, form_id, form_version, status, created_at, updated_at)
VALUES (?, ?, ?, 'draft', ?, ?);
