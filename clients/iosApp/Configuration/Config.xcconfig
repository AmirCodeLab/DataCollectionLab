TEAM_ID=

PRODUCT_NAME=DataCollectionLab
PRODUCT_BUNDLE_IDENTIFIER=com.amr.data_collection_lab.DataCollectionLab$(TEAM_ID)

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0
// The Shared static framework embeds SQLDelight's native driver (SQLiter),
// whose cinterop references the system SQLite; the app does the final link.
OTHER_LDFLAGS = $(inherited) -lsqlite3
