# Every setting backend/app/core/config.py reads, with the default it falls
# back to. Copy to `.env` beside this file and change what you need:
#
#     cp .env.example .env
#
# You do not need this file to run locally. `Settings` ships working defaults
# that match docker-compose.yml, so a clone-and-run needs no configuration —
# this exists because that made the configuration surface discoverable only by
# reading the settings class, which is the wrong place to learn that
# JWT_SECRET exists. Every line below is commented out and shows the default;
# uncomment only what you are changing.
#
# `.env` itself is gitignored. Keep it that way: under rule 11 in
# docs/project-conventions.md, a secret committed here cannot be removed later.

# ---------------------------------------------------------------------------
# Deployment identity

# Which deployment this is. Reported by GET /health, and load-bearing: several
# guards relax only for "development". Anything else is treated as real.
#ENVIRONMENT=development

# FastAPI debug mode. Turn off anywhere a stranger can reach the server.
#DEBUG=true

# ---------------------------------------------------------------------------
# Signing

# The secret every access and refresh token is signed with.
#
# READ THIS ONE. The default below is published in this repository, so tokens
# signed with it can be forged by anyone holding a copy. The server refuses to
# start on it when ENVIRONMENT is not "development" — that refusal is the only
# thing standing between a self-hoster and silently forgeable sessions, and it
# works by recognising this exact string.
#
# So this file ships the published value deliberately rather than a friendlier
# placeholder: a different dummy would look safer, pass the guard, and be just
# as forgeable. Replace it with real entropy, e.g.
#
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# See backend/app/core/published_defaults.py.
#JWT_SECRET=change-me-in-production

# How long an access token is valid, in seconds. Default 15 minutes.
#ACCESS_TOKEN_TTL_SECONDS=900

# How long a refresh token is valid, in seconds. Default 30 days — long,
# because a device may not see the network for weeks.
#REFRESH_TOKEN_TTL_SECONDS=2592000

# ---------------------------------------------------------------------------
# Data stores

# SQLAlchemy async URL. Must be the asyncpg driver, and the database must have
# PostGIS: migration 0001 creates the extension and geography columns.
#DATABASE_URL=postgresql+asyncpg://dcp:dcp@localhost:5432/dcp

# Redis, used by Celery. Database number is part of the URL.
#REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Object storage
#
# The defaults are the MinIO container in docker-compose.yml. Its credentials
# are the well-known local ones — fine for a local stack, not a deployment.

#S3_ENDPOINT=http://localhost:9000
#S3_BUCKET=dcp-media
#S3_ACCESS_KEY=minioadmin
#S3_SECRET_KEY=minioadmin

# ---------------------------------------------------------------------------
# Media uploads

# Where uploaded chunks are written until the S3 backend lands. The seam is
# app/infrastructure/media_storage.py, not this setting.
#MEDIA_STORAGE_ROOT=./var/media

# How long an upload session stays resumable, in seconds. Default 7 days: long
# enough to cross a night in a village with no signal, short enough that
# abandoned half-uploads do not accumulate forever.
#MEDIA_SESSION_TTL_SECONDS=604800

# ---------------------------------------------------------------------------
# Request logging
#
# This is a privacy setting, not a debugging one. Request bodies carry
# respondent data, so logging defaults to on only when ENVIRONMENT=development.

# Force logging on or off regardless of environment. Unset means "on in
# development only".
#HTTP_LOG=

# Keep the request lines but drop the payloads. Authorization, Cookie and
# similar headers are redacted either way, and bodies are truncated at 4 KB.
#HTTP_LOG_BODIES=true
