# Every setting backend/app/core/config.py reads, with the default it falls
# back to. Copy to `.env` beside this file and change what you need:
#
#     cp .env.example .env
#
# You do not need this file to run locally. `Settings` ships working defaults
# that match docker-compose.yml, so a clone-and-run needs no configuration —
# this exists because that made the configuration surface discoverable only by
# reading the settings class, which is the wrong place to learn that
# JWT_SECRET exists. Every line below is commented out and shows the default;
# uncomment only what you are changing.
#
# `.env` itself is gitignored. Keep it that way: under rule 11 in
# docs/project-conventions.md, a secret committed here cannot be removed later.

# ---------------------------------------------------------------------------
# Deployment identity

# Which deployment this is. Reported by GET /health, and load-bearing: several
# guards relax only for "development". Anything else is treated as real.
#ENVIRONMENT=development

# FastAPI debug mode. Turn off anywhere a stranger can reach the server.
#DEBUG=true

# ---------------------------------------------------------------------------
# Sessions

# A session is a cookie and a row (`platform_session`): an opaque token,
# HttpOnly, SameSite=Strict, whose hash is what the row holds. There is no
# signing key to configure. How long one lives without use, in seconds; the
# expiry slides on use. Default 30 days, because a handset may not see the
# network for weeks.
#SESSION_TTL_SECONDS=2592000

# ---------------------------------------------------------------------------
# Data stores

# Two roles, two URLs (docs/project-conventions.md, ERD §1). Both are
# SQLAlchemy async URLs: the asyncpg driver, and a database with PostGIS,
# because migration 0001 creates the extension and geography columns.
#
# The application's connection, as `dcp_app`: the role every row-level
# security policy binds. app/infrastructure/database.py refuses to run on a
# superuser, a BYPASSRLS role or the owner of the tables, because those are
# exempt from the policies and every screen would look correct while none
# applied.
#
# READ THIS ONE. The password below is published in this repository — it is
# what scripts/db_app_role.sql gives the role on a fresh compose volume and
# scripts/reset_dev_db.py on an existing one — so anyone holding a copy of
# the source can open a database that keeps it, as every tenant at once. The
# server refuses to start on it when ENVIRONMENT is not "development"; that
# refusal works by recognising this exact string, so this file ships it
# deliberately rather than a friendlier placeholder that would pass the guard
# and be just as open. See backend/app/core/published_defaults.py.
#DATABASE_URL=postgresql+asyncpg://dcp_app:dcp_app@localhost:5432/dcp

# The owner's connection: migrations, provisioning, the test suite's scratch
# databases. Never a request.
#DATABASE_ADMIN_URL=postgresql+asyncpg://dcp:dcp@localhost:5432/dcp

# SCAFFOLD. The organisation a login is for when the login names none —
# on the pilot's single-tenant deployment, always. After the login the
# `dcp_org` cookie names it for every request. Multi-tenant provisioning
# (Phase 3 §9, not in this phase) replaces this with resolution from the
# hostname and removes the setting; see the comment in config.py.
# scripts/seed_dev.py creates "dev".
#ORGANIZATION_SLUG=dev

# Redis, used by Celery. Database number is part of the URL.
#REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Object storage
#
# The defaults are the MinIO container in docker-compose.yml. Its credentials
# are the well-known local ones — fine for a local stack, not a deployment.

#S3_ENDPOINT=http://localhost:9000
#S3_BUCKET=dcp-media
#S3_ACCESS_KEY=minioadmin
#S3_SECRET_KEY=minioadmin

# ---------------------------------------------------------------------------
# Media uploads

# Where uploaded chunks are written until the S3 backend lands. The seam is
# app/infrastructure/media_storage.py, not this setting.
#MEDIA_STORAGE_ROOT=./var/media

# How long an upload session stays resumable, in seconds. Default 7 days: long
# enough to cross a night in a village with no signal, short enough that
# abandoned half-uploads do not accumulate forever.
#MEDIA_SESSION_TTL_SECONDS=604800

# ---------------------------------------------------------------------------
# Request logging
#
# This is a privacy setting, not a debugging one. Request bodies carry
# respondent data, so logging defaults to on only when ENVIRONMENT=development.

# Force logging on or off regardless of environment. Unset means "on in
# development only".
#HTTP_LOG=

# Keep the request lines but drop the payloads. Authorization, Cookie and
# similar headers are redacted either way, and bodies are truncated at 4 KB.
#HTTP_LOG_BODIES=true
