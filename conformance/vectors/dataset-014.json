{
  "id": "dataset-014",
  "description": "A relevance rule and a choice filter reading the same answer both follow it",
  "spec": "3.2",
  "form": {
    "irVersion": "0.1",
    "formId": "ds14",
    "version": 1,
    "title": {
      "en": "ds14"
    },
    "defaultLanguage": "en",
    "languages": [
      "en"
    ],
    "children": [
      {
        "type": "question",
        "id": "region",
        "dataType": "select_one",
        "label": {
          "en": "Region"
        },
        "choices": {
          "kind": "dataset",
          "dataset": "regions",
          "valueColumn": "name",
          "labelColumn": {
            "en": "label"
          }
        }
      },
      {
        "type": "question",
        "id": "district",
        "dataType": "select_one",
        "label": {
          "en": "District"
        },
        "choices": {
          "kind": "dataset",
          "dataset": "districts",
          "valueColumn": "name",
          "labelColumn": {
            "en": "label"
          },
          "filter": {
            "op": "eq",
            "args": [
              {
                "op": "ref",
                "path": "$row.region_id"
              },
              {
                "op": "ref",
                "path": "region"
              }
            ]
          }
        }
      },
      {
        "type": "question",
        "id": "note_urban",
        "dataType": "text",
        "label": {
          "en": "Note Urban"
        },
        "relevant": {
          "op": "eq",
          "args": [
            {
              "op": "ref",
              "path": "district"
            },
            {
              "op": "lit",
              "value": "D01"
            }
          ]
        }
      }
    ]
  },
  "context": {
    "today": "2026-08-28"
  },
  "steps": [
    {
      "set": {
        "region": "TZ01",
        "district": "D01"
      },
      "expect": {
        "relevant": {
          "note_urban": true
        },
        "valid": {
          "district": true
        }
      }
    },
    {
      "set": {
        "region": "TZ02"
      },
      "expect": {
        "choices": {
          "district": [
            "D03"
          ]
        },
        "valid": {
          "district": false
        },
        "relevant": {
          "note_urban": true
        }
      }
    }
  ],
  "datasets": {
    "regions": [
      {
        "name": "TZ01",
        "label": "Arusha"
      },
      {
        "name": "TZ02",
        "label": "Kilimanjaro"
      }
    ],
    "districts": [
      {
        "name": "D01",
        "label": "Arusha Mjini",
        "region_id": "TZ01",
        "urban": "yes"
      },
      {
        "name": "D02",
        "label": "Arusha Vijijini",
        "region_id": "TZ01",
        "urban": "no"
      },
      {
        "name": "D03",
        "label": "Moshi",
        "region_id": "TZ02",
        "urban": "yes"
      }
    ]
  }
}
