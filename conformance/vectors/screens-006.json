{
  "id": "screens-006",
  "description": "A soft constraint makes a field invalid without blocking finalisation; a hard one on the same form does block",
  "spec": "6.1",
  "form": {
    "irVersion": "0.1",
    "formId": "scr6",
    "version": 1,
    "title": {
      "en": "scr6"
    },
    "defaultLanguage": "en",
    "languages": [
      "en"
    ],
    "children": [
      {
        "type": "question",
        "id": "weight_kg",
        "dataType": "decimal",
        "label": {
          "en": "Weight Kg"
        },
        "constraint": {
          "op": "lte",
          "args": [
            {
              "op": "ref",
              "path": "weight_kg"
            },
            {
              "op": "lit",
              "value": 200
            }
          ]
        },
        "constraintMessage": {
          "en": "Weight over 200 kg — please confirm"
        },
        "severity": "warning"
      },
      {
