        "id": "height_m",
        "dataType": "decimal",
        "label": {
          "en": "Height M"
        },
        "constraint": {
          "op": "lte",
          "args": [
            {
              "op": "ref",
              "path": "height_m"
            },
            {
              "op": "lit",
              "value": 3
            }
          ]
        },
        "constraintMessage": {
          "en": "Height must be 3 m or less"
        }
      }
    ]
  },
  "context": {
    "today": "2026-08-28"
  },
  "steps": [
    {
      "set": {
        "weight_kg": 400.5
      },
      "expect": {
        "valid": {
          "weight_kg": false
        },
        "errors": {
