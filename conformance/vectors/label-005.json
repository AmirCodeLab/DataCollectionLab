{
  "id": "label-005",
  "description": "A label re-renders when what it reads changes — the dependency, not the render",
  "spec": "7.1",
  "form": {
    "irVersion": "0.1",
    "formId": "tagged",
    "version": 1,
    "title": {
      "en": "tagged"
    },
    "defaultLanguage": "en",
    "languages": [
      "en"
    ],
    "children": [
      {
        "type": "question",
        "id": "tag",
        "dataType": "integer",
        "label": {
          "en": "Tag"
        }
      },
      {
        "type": "question",
        "id": "stems",
        "dataType": "note",
        "label": {
          "en": "Stems of tree with tag number {0}"
        },
        "labelArgs": [
          {
            "op": "ref",
            "path": "tag"
          }
        ]
      }
    ]
  },
  "context": {
    "today": "2026-08-28"
  },
  "steps": [
    {
      "set": {
        "tag": 41
      },
      "expect": {
        "renderedLabels": {
          "stems": {
            "en": "Stems of tree with tag number ⁨41⁩"
          }
        }
      }
    },
    {
      "set": {
        "tag": 42
      },
      "expect": {
        "renderedLabels": {
          "stems": {
            "en": "Stems of tree with tag number ⁨42⁩"
          }
        },
        "dependsOn": {
          "stems": [
            "tag"
          ]
        }
      }
    }
  ]
}
