            0,
            1,
            2
          ],
          "next": {
            "0": 1
          },
          "previous": {
            "2": 1
          }
        }
      }
    },
    {
      "expect": {
        "screens": {
          "count": 3,
          "questions": {
            "0": [
              "gate"
            ],
            "1": [
              "fl_real"
            ],
            "2": [
              "tail"
            ]
          },
          "groups": {
            "1": "fl"
          }
        }
      }
    }
  ]
