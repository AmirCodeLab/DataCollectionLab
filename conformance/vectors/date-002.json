{
  "id": "date-002",
  "description": "date_diff_days and date_add_days take ISO text; null operands yield null",
  "spec": "4.3, 4.4",
  "form": {
    "irVersion": "0.1",
    "formId": "date2",
    "version": 1,
    "title": {
      "en": "date2"
    },
    "defaultLanguage": "en",
    "languages": [
      "en"
    ],
    "children": [
      {
        "type": "question",
        "id": "a",
        "dataType": "date",
        "label": {
          "en": "A"
        }
      },
      {
        "type": "question",
        "id": "diff",
        "dataType": "integer",
        "label": {
          "en": "Diff"
        },
        "calculate": {
          "op": "call",
          "fn": "date_diff_days",
          "args": [
            {
              "op": "ref",
              "path": "a"
            },
            {
              "op": "lit",
              "value": "2026-08-20"
            }
          ]
        }
      },
      {
        "type": "question",
        "id": "plus",
        "dataType": "date",
        "label": {
          "en": "Plus"
        },
        "calculate": {
          "op": "call",
          "fn": "date_add_days",
          "args": [
            {
              "op": "ref",
              "path": "a"
            },
            {
              "op": "lit",
              "value": 10
            }
          ]
        }
      }
    ]
  },
  "context": {
    "today": "2026-08-28"
  },
  "steps": [
    {
      "expect": {
        "values": {
          "diff": null,
          "plus": null
        }
      }
    },
    {
      "set": {
        "a": "2026-08-28"
      },
      "expect": {
        "values": {
          "diff": 8,
          "plus": "2026-09-07"
        }
      }
    },
    {
      "set": {
        "a": "2026-02-27"
      },
      "expect": {
        "values": {
          "diff": -174,
          "plus": "2026-03-09"
        }
      }
    }
  ]
}
